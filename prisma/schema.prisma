// This is your prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 枚举定义 (Enums)
// ============================================================================

// 性别枚举
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  GUEST
  HOST
}

// 菜品分类枚举
enum DishCategory {
  SOUP // 汤品
  BEVERAGE // 饮品
  COLD_DISH // 凉菜
  SEASONAL_VEGETABLE // 时令蔬菜
  HOT_DISH // 热菜
  OTHER // 其他
  RECOMMENDED // 推荐
  SNACK_STAPLE // 小吃主食
  SEAFOOD // 海河鲜
  BAIJIU // 白酒
  BEER // 啤酒
  FITNESS_MEAL // 健身餐
}

// 情绪标签枚举
enum EmotionTag {
  HAPPY // 开心
  EXCITED // 兴奋
  WARM // 温馨
  NOSTALGIC // 怀旧
  FUNNY // 搞笑
}

// ============================================================================
// 用户模块 (User Module)
// ============================================================================

// 用户表
model User {
  id           String    @id @default(uuid()) @db.Uuid
  account      String    @unique // 账号（3-16位，只能数字和字母）
  oidcSubject  String?   @unique // Keycloak subject，统一身份绑定
  passwordHash String // 密码哈希
  phone        String?   @unique // 手机号（可选，后期绑定）
  nickname     String? // 昵称
  avatar       String? // 头像 URL
  gender       Gender? // 性别
  birthday     DateTime? // 生日
  bio          String?   @db.VarChar(200) // 个人简介
  createdAt    DateTime  @default(now()) // 创建时间
  updatedAt    DateTime  @updatedAt // 更新时间
  lastLoginAt  DateTime? // 最后登录时间
  lastLoginIp  String? // 最后登录IP
  role         UserRole  @default(GUEST) // 用户角色

  // 关联
  sessions            Session[]
  favorites           Favorite[]
  photos              Photo[]
  photoFavorites      PhotoFavorite[]
  photoComments       PhotoComment[]
  customerOrders      Order[]              @relation("CustomerOrders")
  hostedOrders        Order[]              @relation("HostedOrders")
  hostedGatherings    Gathering[]
  pendingPhotoUploads PendingPhotoUpload[]
}

// 会话表（Lucia Auth 需要）
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  userId    String   @db.Uuid

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 跨实例共享的认证失败计数
model AuthRateLimit {
  key             String    @id @db.VarChar(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

// ============================================================================
// 菜品模块 (Dish Module)
// ============================================================================

// 菜品表
model Dish {
  id           String       @id @default(uuid()) @db.Uuid
  name         String // 菜品名称
  nameEn       String? // 英文名称
  description  String?      @db.VarChar(500) // 描述
  descEn       String?      @db.VarChar(500) // 英文描述
  price        Decimal      @db.Decimal(10, 2) // 价格
  image        String? // 图片URL
  category     DishCategory // 分类
  isSpicy      Boolean      @default(false) // 是否辣
  isVegetarian Boolean      @default(false) // 是否素食
  isAvailable  Boolean      @default(true) // 是否可用
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // 关联
  favorites Favorite[]
  nutrition DishNutrition?
}

// Nutrition values are label values, NOT totals for defaultServingAmount.
// PER_100G/PER_100ML use 100g/100ml; PER_SERVING uses one piece/serving.
model DishNutrition {
  dishId               String   @id @db.Uuid
  basis                String   @db.VarChar(20)
  defaultServingAmount Decimal  @db.Decimal(10, 2)
  servingUnit          String   @db.VarChar(10)
  caloriesKcal         Decimal  @db.Decimal(10, 2)
  proteinG             Decimal? @db.Decimal(10, 2)
  carbohydrateG        Decimal? @db.Decimal(10, 2)
  fatG                 Decimal? @db.Decimal(10, 2)
  fiberG               Decimal? @db.Decimal(10, 2)
  sugarG               Decimal? @db.Decimal(10, 2)
  sodiumMg             Decimal? @db.Decimal(10, 2)
  labelImageUrl        String?
  dish                 Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// 收藏表（用户-菜品关联）
model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  dishId    String   @db.Uuid
  createdAt DateTime @default(now())

  // 关联
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([userId, dishId])
  @@index([userId])
  @@index([dishId])
}

// ============================================================================
// 照片模块 (Photo Module)
// ============================================================================

// 照片表
model Photo {
  id           String      @id @default(uuid()) @db.Uuid
  title        String // 标题
  description  String?     @db.VarChar(500) // 描述
  url          String // 原图 URL
  thumbnailUrl String? // 缩略图 URL
  mediumUrl    String? // 中等尺寸 URL
  width        Int? // 原图宽度
  height       Int? // 原图高度
  emotionTag   EmotionTag? // 情绪标签（可选）
  gatheringId  String?     @db.Uuid // 所属聚会（可选）
  uploaderId   String      @db.Uuid // 上传者
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // 关联
  gathering Gathering?      @relation(fields: [gatheringId], references: [id])
  uploader  User            @relation(fields: [uploaderId], references: [id])
  favorites PhotoFavorite[]
  comments  PhotoComment[]

  @@index([uploaderId])
  @@index([gatheringId])
  @@index([createdAt])
}

// 照片收藏表
model PhotoFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  photoId   String   @db.Uuid
  createdAt DateTime @default(now())

  // 关联
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId])
  @@index([userId])
  @@index([photoId])
}

// 照片评论表
model PhotoComment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String   @db.VarChar(500) // 评论内容
  photoId   String   @db.Uuid
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  photo  Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([authorId])
}

model PendingPhotoUpload {
  id         String   @id @default(uuid()) @db.Uuid
  key        String
  url        String
  uploaderId String   @db.Uuid
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@unique([uploaderId, url])
  @@index([uploaderId])
  @@index([createdAt])
}

// ============================================================================
// 订单模块 (Order Module)
// ============================================================================

// 订单状态枚举
enum OrderStatus {
  PENDING // 待处理（等待主人接单）
  CONFIRMED // 已确认（主人接单）
  COMPLEED // 已完成
  CANCELLED // 已取消
}

// 订单表
model Order {
  id           String      @id @default(uuid()) @db.Uuid
  orderNumber  String      @unique // 订单号（如：ORD-20250130-001）
  customerId   String      @db.Uuid // 客户（点餐的人）
  hostId       String      @db.Uuid // 主人（接单的人）
  gatheringId  String?     @db.Uuid // 所属聚会
  customerName String // 客户名称（昵称或手机号）
  status       OrderStatus @default(PENDING) // 订单状态
  totalAmount  Decimal     @db.Decimal(10, 2) // 总金额
  remark       String?     @db.VarChar(500) // 备注
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  confirmedAt  DateTime? // 确认时间

  // 关联
  customer  User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  host      User        @relation("HostedOrders", fields: [hostId], references: [id], onDelete: Restrict)
  gathering Gathering?  @relation(fields: [gatheringId], references: [id], onDelete: SetNull)
  items     OrderItem[]

  @@index([customerId])
  @@index([hostId])
  @@index([gatheringId])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([hostId, status, createdAt])
}

// 订单明细表
model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  dishId      String   @db.Uuid
  dishName    String // 下单时的菜品名称
  price       Decimal  @db.Decimal(10, 2) // 下单时的单价
  quantity    Int      @default(1) // 数量
  weightGrams Decimal? @db.Decimal(10, 2) // 健身菜实际食用重量（克）
  volumeMl    Decimal? @db.Decimal(10, 2) // 液体健身菜实际饮用量（毫升）
  remark      String?  @db.VarChar(200) // 备注（如：不加香菜）
  createdAt   DateTime @default(now())

  // 关联
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============================================================================
// 聚会模块更新（合并到此处）
// ============================================================================

// 聚会表
model Gathering {
  id          String   @id @default(uuid()) @db.Uuid
  title       String // 聚会标题
  description String?  @db.VarChar(500) // 描述
  date        DateTime // 聚会日期
  location    String? // 地点
  inviteCode  String?  @unique // 邀请码（可选）
  isActive    Boolean  @default(true) // 是否有效
  hostId      String   @db.Uuid // 聚会主人
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  host   User    @relation(fields: [hostId], references: [id], onDelete: Restrict)
  photos Photo[]
  orders Order[]

  @@index([inviteCode])
  @@index([hostId])
}

